# --- Runtime ---
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# --- CORS (Mini App origin + admin panel origin) ---
# Comma-separated list. Use "*" only in development.
CORS_ORIGINS=http://localhost:3000,https://t.me

# --- Database ---
DATABASE_URL=postgresql://alpinavpn:alpinavpn@localhost:5432/alpinavpn?schema=public

# --- Auth ---
# Telegram bot token from @BotFather. Used to verify initData HMAC.
TELEGRAM_BOT_TOKEN=replace-me
# Set to "true" to allow unsigned dev requests via X-Dev-Telegram-Id header.
# MUST be "false" in production.
ALLOW_DEV_AUTH=false

# JWT for our own session tokens (issued after initData verification)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=7d

# initData freshness window in seconds (Telegram recommends 24h max)
TELEGRAM_AUTH_TTL_SECONDS=86400

# --- Rate limiting ---
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# --- Bootstrap admin (seed) ---
# Comma-separated Telegram IDs that are promoted to admin on first login.
BOOTSTRAP_ADMIN_TELEGRAM_IDS=

# --- Region ---
# ISO-3166 alpha-2 region pinned to every new order/subscription now that the
# checkout no longer asks the user to pick a country. Must reference a seeded,
# active Country (falls back to the first active country if missing).
DEFAULT_REGION_CODE=NL

# --- VPN provider ---
# Either "mock" (default) or "marzban" (live Marzban REST integration)
VPN_PROVIDER=mock
MARZBAN_API_URL=
MARZBAN_API_USERNAME=
MARZBAN_API_PASSWORD=
# Origin used to build absolute subscription URLs from Marzban's relative
# subscription_url. Defaults to the MARZBAN_API_URL origin when blank.
MARZBAN_SUBSCRIPTION_BASE_URL=
# JSON map of proxy protocols → settings the provisioned user is created with.
MARZBAN_PROXIES_JSON={"vless":{}}
# Optional JSON map of protocol → inbound tags. Leave blank to use all inbounds.
MARZBAN_INBOUNDS_JSON=

# --- Telegram bot / moderation ---
# disabled = no bot loop (default — tests/CI/local Mini App work)
# polling  = long-polling (dev)
# webhook  = HTTPS webhook (prod; requires TELEGRAM_WEBHOOK_DOMAIN + SECRET)
TELEGRAM_BOT_MODE=disabled
# Bot @username without the leading "@". Used in deep links and DMs.
TELEGRAM_BOT_USERNAME=AlpinaVpnBot
# Chat id of the operator moderation channel (negative for supergroups).
# Required when TELEGRAM_BOT_MODE != disabled.
TELEGRAM_MODERATION_CHAT_ID=
# Public HTTPS origin of this backend (no trailing slash).
# Required when TELEGRAM_BOT_MODE=webhook.
TELEGRAM_WEBHOOK_DOMAIN=
# Random 32+ char secret. Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=
# Public Mini App URL (deep link or t.me/<botname>/<appname>).
MINI_APP_URL=https://t.me

# --- Receipts storage ---
# Where receipt files are saved. Absolute or relative to the backend cwd.
RECEIPTS_STORAGE_DIR=./storage/receipts
# Hard cap per receipt (bytes). 8 MiB by default; stays below Telegram's 10 MiB photo limit.
RECEIPTS_MAX_BYTES=8388608
