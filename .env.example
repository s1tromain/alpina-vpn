# Alpina VPN — frontend (Next.js Mini App) environment + Compose orchestration.
# Copy to `.env` (Docker Compose reads it) or `.env.local` (Next.js dev).

# --- Public domain (Compose + nginx) ---
# Origin the Mini App is served from. Used:
#   - as the backend's CORS_ORIGINS in docker-compose.yml
#   - as documentation for which BotFather domain to register
# Multiple origins comma-separated, e.g. https://app.example.com,https://admin.example.com
PUBLIC_FRONTEND_ORIGIN=https://your-domain.example

# --- API connection (frontend) ---
# Public origin of the Fastify backend. Leave EMPTY in development so the
# Next.js `rewrites()` in next.config.js proxies /api/* to the local
# backend; in production, nginx handles the same routing, so leave EMPTY
# unless you intentionally split frontend and API onto different domains.
NEXT_PUBLIC_API_URL=

# Used only by the dev-mode rewrite proxy. Ignored when NEXT_PUBLIC_API_URL
# is set. In Compose this points at the internal `backend` service name.
BACKEND_URL=http://localhost:4000

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=AlpinaVPNBot
NEXT_PUBLIC_SUPPORT_HANDLE=alpinavpn_support

# --- Backend secrets (Compose passes these into the backend container) ---
# 32+ chars of high-entropy random — `openssl rand -hex 32`
JWT_SECRET=
JWT_ACCESS_TTL=7d

# Comma-separated Telegram IDs auto-promoted to admin on first login.
BOOTSTRAP_ADMIN_TELEGRAM_IDS=

# --- Database (Compose owns these — keep in sync between services) ---
POSTGRES_USER=alpinavpn
POSTGRES_PASSWORD=alpinavpn
POSTGRES_DB=alpinavpn

# --- VPN provider ---
VPN_PROVIDER=mock
MARZBAN_API_URL=
MARZBAN_API_USERNAME=
MARZBAN_API_PASSWORD=

# --- Optional rate-limit tuning ---
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# --- Optional: legacy edge admin gate ---
# Comma-separated Telegram IDs allowed to view /admin/* routes from the
# frontend perspective. The backend separately enforces role checks on
# every admin endpoint; this is defence-in-depth at the edge. Leave empty
# to rely entirely on the backend's JWT role check (recommended for most
# deployments).
ADMIN_ALLOWED_TELEGRAM_IDS=

# --- Optional logging ---
LOG_LEVEL=info
